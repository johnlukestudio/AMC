# Always revalidate the HTML shell so new deploys show without a hard refresh.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <If "%{REQUEST_URI} == '/' || %{REQUEST_URI} == '/index.html'">
    Header set Cache-Control "no-cache, must-revalidate"
  </If>
</IfModule>

<Files ".ht*">
  Require all denied
</Files>

# Clean path URLs. Each route is a real HTML file under /prerender.
# Fragments (#/about) never reach Apache; the app redirects those in the browser.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Don't expose the prerender files as their own URLs.
  RewriteCond %{THE_REQUEST} \s/prerender/(.+)\.html[\s?] [NC]
  RewriteRule ^prerender/(.+)\.html$ /$1 [R=301,L]

  # Aliases → one canonical path. Query strings are kept.
  RewriteRule ^services/commercial-casework/?$ /americase [R=301,L,QSA]
  RewriteRule ^services/casework/?$ /americase [R=301,L,QSA]
  RewriteRule ^services/millwork/?$ /services/architectural-millwork [R=301,L,QSA]
  RewriteRule ^installers/?$ /divisions/american-installers [R=301,L,QSA]
  RewriteRule ^portfolio/?$ /portfolio/millwork [R=301,L,QSA]
  RewriteRule ^portfolio/project/?$ /portfolio/project/ave-blue-bell [R=301,L,QSA]
  RewriteRule ^index\.html$ / [R=301,L]

  # /about/ → /about (real directories such as /media/ are left alone)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Known routes: serve that route's HTML without changing the URL.
  RewriteCond %{DOCUMENT_ROOT}/prerender%{REQUEST_URI}.html -f
  RewriteRule ^(.+)$ /prerender/$1.html [END]

  # Everything else that isn't a real file is a 404.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ - [R=404,L]
</IfModule>

ErrorDocument 404 /404.html

# Beta password
AuthType Basic
AuthName "AMC beta"
AuthUserFile "/home/1428402.cloudwaysapps.com/kjamzpykft/private_html/.htpasswd"
Require valid-user
