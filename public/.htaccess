# Always revalidate the HTML shell so new deploys show without a hard refresh.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <If "%{REQUEST_URI} == '/' || %{REQUEST_URI} == '/index.html'">
    Header set Cache-Control "no-cache, must-revalidate"
  </If>
</IfModule>

<Files ".ht*">
  Require all denied
</Files>

# Clean path URLs. Each route is a real HTML file under /prerender.
# Fragments (#/about) never reach Apache; the app redirects those in the browser.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Each route is a real directory with index.html, which nginx can serve.
  # These 301s run when the request reaches Apache (before that directory index).
  RewriteRule ^services/commercial-casework/?$ /americase/ [R=301,L,QSA]
  RewriteRule ^services/casework/?$ /americase/ [R=301,L,QSA]
  RewriteRule ^services/millwork/?$ /services/architectural-millwork/ [R=301,L,QSA]
  RewriteRule ^installers/?$ /divisions/amc-installers/ [R=301,L,QSA]
  RewriteRule ^divisions/american-installers/?$ /divisions/amc-installers/ [R=301,L,QSA]
  RewriteRule ^portfolio/?$ /portfolio/millwork/ [R=301,L,QSA]
  RewriteRule ^portfolio/project/?$ /portfolio/project/ave-blue-bell/ [R=301,L,QSA]
  RewriteRule ^index\.html$ / [R=301,L]

  # /about (no slash) is a directory. Leave /about/ alone.
  # Unknown /missing/ still drops the slash before the 404 below.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Everything else that isn't a real file or directory is a 404.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ - [R=404,L]
</IfModule>

ErrorDocument 404 /404.html

# Beta password
AuthType Basic
AuthName "AMC beta"
AuthUserFile "/home/1428402.cloudwaysapps.com/kjamzpykft/private_html/.htpasswd"
Require valid-user
